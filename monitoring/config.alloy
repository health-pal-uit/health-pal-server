logging {
  level = "info"
}

// Only these two application log files are mounted read-only.
loki.source.file "recognition" {
  targets = [
    {__path__ = "/var/log/healthpal/backend.stdout.log", job = "healthpal-recognition", service = "health-pal-server", environment = "local"},
    {__path__ = "/var/log/healthpal/backend.stderr.log", job = "healthpal-recognition", service = "health-pal-server", environment = "local"},
  ]
  forward_to = [loki.process.recognition.receiver]
}

loki.process "recognition" {
  forward_to = [loki.write.local.receiver]

  stage.decolorize {}

  // Drop startup, SQL, authentication and unrelated module logs before export.
  stage.match {
    selector = "{job=\"healthpal-recognition\"} !~ \"\\\"event\\\":\\\"food_recognition(_failed)?\\\"\""
    action = "drop"
    drop_counter_reason = "outside_recognition_scope"
  }

  stage.regex {
    expression = "(?P<event_json>\\{\"event\":\"food_recognition(?:_failed)?\".*\\})"
  }

  stage.json {
    source = "event_json"
    expressions = {
      event = "event",
      request_id = "request_id",
      endpoint = "endpoint",
      upstream_status = "upstream_status",
      transport_code = "transport_code",
      elapsed_ms = "elapsed_ms",
    }
  }

  // Export an explicit field allowlist, never the original application line.
  stage.template {
    source = "safe_line"
    template = "{\"event\":\"{{ .event }}\",\"request_id\":\"{{ .request_id }}\",\"endpoint\":\"{{ .endpoint }}\",\"upstream_status\":\"{{ if .upstream_status }}{{ .upstream_status }}{{ end }}\",\"transport_code\":\"{{ if .transport_code }}{{ .transport_code }}{{ end }}\",\"elapsed_ms\":{{ .elapsed_ms }}}"
  }

  stage.output {
    source = "safe_line"
  }

  // Small fixed-value labels only; request_id remains searchable JSON content.
  stage.labels {
    values = {event = "event", endpoint = "endpoint", upstream_status = "upstream_status"}
  }

  stage.label_drop {
    values = ["filename"]
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
