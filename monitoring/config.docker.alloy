logging {
  level = "info"
}

// Discover only explicitly labelled recognition backends.
discovery.docker "recognition" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
  filter {
    name = "label"
    values = ["healthpal.logs=recognition"]
  }
}

discovery.relabel "recognition" {
  targets = discovery.docker.recognition.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex = sys.env("HEALTHPAL_COMPOSE_PROJECT")
    action = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex = "health-pal-server"
    action = "keep"
  }
  rule {
    target_label = "job"
    replacement = "healthpal-recognition"
  }
  rule {
    target_label = "service"
    replacement = "health-pal-server"
  }
  rule {
    target_label = "environment"
    replacement = "docker"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label = "project"
  }
}

loki.source.docker "recognition" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.recognition.output
  labels = {}
  forward_to = [loki.process.recognition.receiver]
}
